# Copy to .env.local (never commit real keys). Everything here is optional.

# Enables the LLM claim extractor (claims are still grounded/validated deterministically).
# ANTHROPIC_API_KEY=
# MEMORY_COURT_MODEL=claude-sonnet-5

# GBrain location / binaries (defaults shown)
# MEMORY_COURT_GBRAIN_HOME=~/.memory-court/gbrain-home   # parent of .gbrain; must be outside a git worktree
# MEMORY_COURT_BUN=~/.bun/bin/bun
# MEMORY_COURT_GBRAIN=~/.bun/bin/gbrain
# MEMORY_COURT_DATA_DIR=./.data                          # audit log, claim store, eval report
